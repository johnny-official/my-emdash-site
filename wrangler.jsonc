{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "my-emdash-site",
	"account_id": "3cec6d0a5b9ec98cc0f6b8dbc3ec1342",
	"routes": [
		{ "pattern": "blog.hellojohnny.xyz", "custom_domain": true }
	],
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "my-emdash-site","database_id": "ebc19c7c-51b6-4cd9-b57d-a4fb6136a2f2",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "my-emdash-media","preview_bucket_name": "my-emdash-media",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
